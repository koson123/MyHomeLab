# Copy to .env and replace every example value.
GAMEHUB_DB_PASSWORD=replace-with-a-long-random-password
GAMEHUB_API_KEY=replace-with-a-long-random-api-key
GAMEHUB_AGENT_TOKEN=replace-with-a-separate-long-random-agent-token

# Exact hostnames/IPs Game Hub may contact as launch agents, comma-separated.
# Leave empty until an agent is intentionally registered.
GAMEHUB_ALLOWED_AGENT_HOSTS=
